{
  "name": "mnemom-docs-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only deps for docs CI scripts. Mintlify builds the site; this package.json is consumed only by scripts/ via `node`. Do not introduce build-time deps here.",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:doc-examples": "node scripts/check-doc-examples.mjs",
    "check:img-alt": "node scripts/check-img-alt.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:nav-pages": "node scripts/check-nav-pages.mjs",
    "check:nav-coverage": "node scripts/check-nav-coverage.mjs",
    "check:links": "node scripts/check-links-local.mjs",
    "check:model-coverage": "node scripts/check-model-coverage.mjs",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:heading-hierarchy": "node scripts/check-heading-hierarchy.mjs",
    "link-health-report": "node scripts/link-health-report.mjs",
    "check:link-health": "node scripts/link-health-metrics.mjs",
    "check:deprecation-coverage": "node scripts/check-deprecation-coverage.mjs",
    "check:path-references": "node scripts/check-path-references.mjs",
    "check:concept-fields": "node scripts/check-concept-fields.mjs",
    "check:grounding-corpus": "node scripts/check-grounding-corpus.mjs",
    "probe:origin-edge": "node scripts/probe-docs-origin-edge.mjs",
    "test:probe": "node --test scripts/probe-docs-origin-edge.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "mintlify": "^4.2.592",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
